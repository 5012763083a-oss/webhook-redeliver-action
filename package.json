{
  "name": "webhook-redeliver-action",
  "version": "1.0.0",
  "description": "GitHub Action that redelivers failed repository webhook deliveries on a schedule.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --format=esm --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=dist/index.js",
    "test": "node --test test/"
  },
  "dependencies": { "@actions/cache": "^4.0.0", "@actions/core": "^1.11.1" },
  "devDependencies": { "esbuild": "^0.24.0" }
}
